<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_12">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_img_avatar"
            android:layout_width="@dimen/discover_item_avatar_size"
            android:layout_height="@dimen/discover_item_avatar_size"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/item_lbl_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/default_username"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/space_16"
            app:layout_constraintStart_toEndOf="@id/item_img_avatar"
            app:layout_constraintTop_toTopOf="@id/item_img_avatar"
            app:layout_constraintBottom_toBottomOf="@id/item_img_avatar"
            app:layout_constraintEnd_toStartOf="@id/item_btn_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_btn_add"
            android:layout_width="@dimen/clear_btn_size"
            android:layout_height="@dimen/clear_btn_size"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@drawable/ic_add_person"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="@dimen/btn_radius_m"
            app:strokeColor="@color/nav_selected"
            app:strokeWidth="@dimen/stroke_thin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>