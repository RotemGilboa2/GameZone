<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:padding="@dimen/default_card_margin">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/avatar_lbl_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/avatar_choose_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/avatar_btn_close" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar_btn_close"
        android:layout_width="@dimen/avatar_close_size"
        android:layout_height="@dimen/avatar_close_size"
        android:background="@drawable/bg_circle_inner"
        android:padding="@dimen/avatar_close_padding"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/text_muted"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/avatar_rv"
        android:layout_width="0dp"
        android:layout_height="@dimen/avatar_grid_height"
        android:layout_marginTop="@dimen/space_14"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_12"
        app:layout_constraintTop_toBottomOf="@id/avatar_lbl_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>