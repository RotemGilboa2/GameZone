<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chat_item_height"
    android:layout_marginBottom="@dimen/default_card_margin"
    android:background="@color/card_dark"
    android:padding="@dimen/space_12">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/item_req_img_avatar"
        android:layout_width="@dimen/chat_avatar_size"
        android:layout_height="@dimen/chat_avatar_size"
        android:scaleType="centerCrop"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_req_lbl_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_username"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="@dimen/text_16"
        android:layout_marginStart="@dimen/space_12"
        app:layout_constraintStart_toEndOf="@id/item_req_img_avatar"
        app:layout_constraintEnd_toStartOf="@id/item_req_btn_accept"
        app:layout_constraintTop_toTopOf="@id/item_req_img_avatar" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_req_lbl_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/request_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_subtitle"
        android:layout_marginTop="@dimen/space_xs"
        app:layout_constraintStart_toStartOf="@id/item_req_lbl_username"
        app:layout_constraintEnd_toStartOf="@id/item_req_btn_accept"
        app:layout_constraintTop_toBottomOf="@id/item_req_lbl_username" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_req_btn_accept"
        android:layout_width="@dimen/request_action_size"
        android:layout_height="@dimen/request_action_size"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        app:cornerRadius="@dimen/tab_corner_radius"
        app:backgroundTint="@color/nav_selected"
        android:contentDescription="@string/content_desc_accept"
        android:text="✓"
        android:textColor="@color/bg_dark"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/item_req_btn_decline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_req_btn_decline"
        android:layout_width="@dimen/request_action_size"
        android:layout_height="@dimen/request_action_size"
        android:layout_marginStart="@dimen/space_8"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        app:cornerRadius="@dimen/tab_corner_radius"
        app:backgroundTint="@color/card_inner"
        android:contentDescription="@string/content_desc_decline"
        android:text="✕"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>